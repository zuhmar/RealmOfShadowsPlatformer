{
  "name": "realm-of-shadows",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @ros/server",
    "dev:web": "npm run dev -w @ros/web",
    "build": "npm run build -w @ros/web && npm run build -w @ros/server",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "npm run db:generate -w @ros/server",
    "db:migrate": "npm run db:migrate -w @ros/server",
    "test:integration": "node --env-file-if-exists=apps/server/.env --import tsx --test --test-concurrency=1 tests/*.integration.ts",
    "test:browser": "node --env-file-if-exists=apps/server/.env scripts/browser-check.mjs && node --env-file-if-exists=apps/server/.env scripts/browser-game.mjs",
    "format": "prettier --write apps packages tests scripts README.md *.json *.yaml",
    "test:browser:wolf": "node scripts/browser-wolf.mjs",
    "test:browser:characters": "node scripts/browser-characters.mjs",
    "test:browser:woods": "node scripts/browser-woods.mjs",
    "test:browser:quest": "node --env-file-if-exists=apps/server/.env scripts/browser-quest.mjs",
    "test:browser:weapons": "node scripts/browser-weapons.mjs",
    "test:browser:village": "node scripts/browser-village.mjs",
    "test:browser:fullscreen": "node scripts/browser-fullscreen.mjs",
    "test:browser:game-layout": "node --env-file-if-exists=apps/server/.env scripts/browser-game-layout.mjs",
    "test:browser:portals": "node --env-file-if-exists=apps/server/.env scripts/browser-portals.mjs",
    "test:browser:gathering": "node --env-file-if-exists=apps/server/.env scripts/browser-gathering.mjs",
    "test:browser:gathering-animations": "node scripts/browser-gathering-animations.mjs",
    "test:browser:forge": "node --env-file-if-exists=apps/server/.env scripts/browser-forge.mjs",
    "test:browser:woods-areas": "node --env-file-if-exists=apps/server/.env scripts/browser-woods-areas.mjs",
    "test:browser:boss-props": "node scripts/browser-boss-props.mjs",
    "test:browser:boss-combat": "node scripts/browser-boss-combat.mjs",
    "test:browser:woods-progression": "node --env-file-if-exists=apps/server/.env scripts/browser-woods-progression.mjs",
    "test:browser:equipment": "node --env-file-if-exists=apps/server/.env scripts/browser-equipment.mjs",
    "test:browser:island-equipment": "node --env-file-if-exists=apps/server/.env scripts/browser-island-equipment.mjs",
    "test:browser:equipment-management": "node --env-file-if-exists=apps/server/.env scripts/browser-equipment-management.mjs",
    "test:browser:loot": "node scripts/browser-loot-feedback.mjs",
    "balance:woods": "node --import tsx scripts/balance-woods.ts",
    "test:browser:world-map": "node --env-file-if-exists=apps/server/.env scripts/browser-world-map.mjs",
    "test:browser:island-weapons": "node scripts/browser-island-weapons.mjs",
    "test:browser:murkmire": "node scripts/browser-murkmire.mjs",
    "test:browser:murkmire-flow": "node --env-file-if-exists=apps/server/.env scripts/browser-murkmire-flow.mjs",
    "test:browser:crystal-terrain": "node scripts/browser-crystal-terrain.mjs",
    "test:browser:traversal": "node scripts/browser-island-traversal.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
